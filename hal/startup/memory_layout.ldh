RAM_SIZE = 96K;
ROM_SIZE = 1024K;
FLASH_PAGE_SIZE = 0x800;

RAM_EXCHANGE_START = 0x20000000;
RAM_EXCHANGE_SIZE = 128;
RAM_START  = RAM_EXCHANGE_START + RAM_EXCHANGE_SIZE;

APP_HEADER_SIZE = FLASH_PAGE_SIZE;

BOOT_START = 0x08000000;
BOOT_SIZE  = 48K - APP_HEADER_SIZE;

APP_START  = BOOT_START + BOOT_SIZE + APP_HEADER_SIZE;
APP_SIZE   = ROM_SIZE - BOOT_SIZE - APP_HEADER_SIZE;

PROVIDE(__boot_start__ = BOOT_START);
PROVIDE(__boot_size__ = BOOT_SIZE);
PROVIDE(__app_start__ = APP_START);
PROVIDE(__app_size__ = APP_SIZE);