#ifndef LOG_L476_H_
#define LOG_L476_H_

#ifdef __cplusplus
extern "C" {
#endif

//------------------------------------------------------------------------------

#include <string.h>
#include <stdio.h>

#include <stm32l4xx_hal.h>

//------------------------------------------------------------------------------

void log_string(char *s);

void log_init(void);

#define LOG(format, ...) {char buf[128]; sprintf(buf, format __VA_OPT__(,) __VA_ARGS__); log_string(buf);}


//------------------------------------------------------------------------------

#ifdef __cplusplus
}
#endif

#endif /* LOG_L476_H_ */

//------------------------------------------------------------------------------
