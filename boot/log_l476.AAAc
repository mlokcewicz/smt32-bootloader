#include "log_l476.h"

//------------------------------------------------------------------------------

UART_HandleTypeDef husart2 = 
{
    .Instance = USART2,
    .Init.BaudRate = 115200,
    .Init.Mode = USART_MODE_TX_RX,
    .Init.Parity = USART_PARITY_NONE,
    .Init.StopBits = USART_STOPBITS_1,
    .Init.WordLength = USART_WORDLENGTH_8B,
};

GPIO_InitTypeDef hgppio_usart2 = 
{
    .Alternate = GPIO_AF7_USART2,
    .Mode = GPIO_MODE_AF_OD,
    .Pin =  GPIO_PIN_2 | GPIO_PIN_3,
    .Pull = GPIO_PULLUP,
    .Speed = GPIO_SPEED_FREQ_VERY_HIGH,
};

void HAL_UART_MspInit(UART_HandleTypeDef *husart)
{
    __HAL_RCC_USART2_CLK_ENABLE();
    __HAL_RCC_GPIOA_CLK_ENABLE();

    HAL_GPIO_Init(GPIOA, &hgppio_usart2);
}

//------------------------------------------------------------------------------

void log_string(char* s)
{
    HAL_UART_Transmit(&husart2, (const uint8_t *)s, strlen(s), HAL_MAX_DELAY);
}

void log_init(void)
{
    HAL_UART_Init(&husart2);
}

//------------------------------------------------------------------------------
